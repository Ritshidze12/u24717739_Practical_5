<script type="text/javascript">

    $("#accordion").accordion({
        // Slide animation or not or length
        animate: 500,
        // Starting tab
        active: false,
        // Collapsible if same tab is clicked
        collapsible: true,
        // Event that triggers
        event: "click",
        // Height based on content (content) or largest (auto)
        heightStyle: "content"
    });
</script>